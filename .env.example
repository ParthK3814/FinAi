# Copy this file to .env in the project root:   cp .env.example .env
# Both the backend and the frontend read this one file.

# --- Backend ---------------------------------------------------------------
# PostgreSQL connection string (SQLAlchemy format).
# Matches the docker-compose.yml database. Change it if you use your own Postgres.
DATABASE_URL=postgresql+psycopg2://finai:finai@localhost:5432/finai

# Origins allowed to call the API (comma-separated). Vite's dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173

# Load demo data on startup when the database is empty (true / false).
AUTO_SEED=true

# Currency code used for display (USD, EUR, INR, GBP, ...).
CURRENCY=USD

# --- Frontend --------------------------------------------------------------
# Where the React app finds the API. Only VITE_* variables reach the browser.
VITE_API_URL=http://localhost:8000/api
